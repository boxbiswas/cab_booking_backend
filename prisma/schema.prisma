generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

// -----------------------------------------------------------------------------
// [REMOVED]: Role enum is not since the entire application is
// single-actor (Rider-only). All users are riders interacting with the system.
// -----------------------------------------------------------------------------
// enum Role {
//   RIDER
//   DRIVER
//   ADMIN
// }

/// Vehicle categorization matching ride tiers (Sedan, Hatchback, SUV, Auto).
enum VehicleType {
  SEDAN
  HATCHBACK
  SUV
  AUTO
}

/// Lifecycle states of a ride request from the Rider's perspective.
enum RideStatus {
  REQUESTED
  ACCEPTED
  DRIVER_ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Entity that initiated ride cancellation (Rider or automated System).
enum CancelledBy {
  RIDER
  SYSTEM
  // DRIVER - [REMOVED]: No driver app/actor
  // ADMIN  - [REMOVED]: No admin app/actor
}

/// Supported payment methods for rider checkout.
enum PaymentMethodEnum {
  CARD
  WALLET
  UPI
  OTHER
}

/// Processing status of a payment transaction.
enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// Discount calculation type for promotional codes.
enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// Status of an in-ride emergency/SOS alert.
enum AlertStatus {
  TRIGGERED
  ACKNOWLEDGED
  RESOLVED
}

/// Categorization for customer support tickets filed by riders.
enum SupportCategory {
  PAYMENT
  LOST_ITEM
  DRIVER_ISSUE
  RIDE_ISSUE
  OTHER
}

/// Lifecycle states of customer support tickets.
enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// System and event notification types received by riders.
enum NotificationType {
  RIDE_REQUEST
  RIDE_ACCEPTED
  DRIVER_ARRIVING
  RIDE_STARTED
  RIDE_COMPLETED
  RIDE_CANCELLED
  PAYMENT
  SOS
  SUPPORT
}

// =============================================================================
// CORE USER MODEL (RIDER ONLY)
// =============================================================================

/// Core Rider entity representing the authenticated app user.
/// Supports both credentials and social authentication (e.g. Clerk / OAuth).
model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  phone        String   @unique @db.VarChar(20)
  passwordHash String?  @db.VarChar(255) // Optional to accommodate social logins / Clerk
  profileImage String?  @db.VarChar(2048)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  // ---------------------------------------------------------------------------
  // [REMOVED]: Role field removed — app is 100% Rider-only
  // ---------------------------------------------------------------------------
  // role          Role     @default(RIDER)

  // Rider Relationships
  rides             Ride[]             @relation("RiderToRide")
  payments          Payment[]          @relation("RiderToPayment")
  paymentMethods    PaymentMethod[]
  reviews           Review[]           @relation("RiderToReview")
  emergencyContacts EmergencyContact[]
  supportTickets    SupportTicket[]
  notifications     Notification[]
  emergencyAlerts   EmergencyAlert[]

  // ---------------------------------------------------------------------------
  // [REMOVED]: Driver-specific relations
  // ---------------------------------------------------------------------------
  // driverProfile     DriverProfile?
  // ridesAsDriver     Ride[]             @relation("DriverToRide")
  // paymentsAsDriver  Payment[]          @relation("DriverToPayment")
  // reviewsAsDriver   Review[]           @relation("DriverToReview")

  @@index([email])
  @@index([phone])
}

